{
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "es2020",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "strict": true,
        "target": "es2021",
        "baseUrl": "./",
        "noEmit": true, // We use esbuild to generate code.
        "incremental": true,
        "paths": {
            "@sierra/web": ["../web/types.ts"],
            "@sierra/web-react": ["./index.ts"]
        },
        "lib": [
            "dom",
            "dom.iterable",
            "es2021" // Our actual target
        ]
    }
}
